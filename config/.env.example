# API Keys — Google Photos Review Analysis Pipeline
# Copy this file to .env and fill in your actual keys

# Groq API (LLM for filtering & extraction)
GROQ_API_KEY=your_groq_api_key_here

# Note: Reddit and YouTube collectors use browser-based scraping
# and do NOT require API keys. Video IDs are configured in
# /config/youtube_video_ids.json instead.
