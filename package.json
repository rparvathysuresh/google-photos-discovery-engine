{
  "name": "google-photos-review-analysis",
  "version": "1.0.0",
  "description": "Multi-agent research pipeline for discovering incomplete-memory retrieval failures in Google Photos user feedback.",
  "main": "agents/orchestrator.js",
  "scripts": {
    "start": "node server/index.js",
    "build": "cd client && npm install && npm run build",
    "pipeline": "node agents/orchestrator.js",
    "collect": "node agents/orchestrator.js --stage 1",
    "filter": "node agents/orchestrator.js --stage 2",
    "extract": "node agents/orchestrator.js --stage 3",
    "extract:sample": "node agents/orchestrator.js --stage 3 --sample",
    "cluster": "node agents/orchestrator.js --stage 4",
    "validate-schema": "node -e \"const u = require('./agents/utils'); const r = u.validateRecord(JSON.parse(process.argv[1]));  console.log(r.valid ? 'VALID' : JSON.stringify(r.errors, null, 2));\"",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "app-store-scraper": "^0.18.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.0",
    "express": "^5.2.1",
    "google-play-scraper": "^10.1.3",
    "googleapis": "^181.0.0",
    "groq-sdk": "^1.6.0",
    "ml-kmeans": "^7.0.1",
    "puppeteer": "^25.11.0",
    "snoowrap": "^1.23.0"
  }
}
